# Pilot RC configuration example.
# Copy values into Render environment variables or a local .env file.
# Do not commit real secrets.

RESEARCH_PSEUDONYMIZATION_SALT=replace-with-a-long-random-secret

# Persistent RC storage root. On Render this must point to a persistent disk.
PILOT_RC_DATA_ROOT=/var/data/psych-backend-pilot-rc
PILOT_RC_REQUIRE_PERSISTENT_DATA_ROOT=true

# Closed RC researcher access gate.
RESEARCHER_ACCESS_USERNAME=replace-with-researcher-username
RESEARCHER_ACCESS_PASSWORD=replace-with-strong-password
RESEARCHER_SESSION_SECRET=replace-with-long-random-cookie-signing-secret
PILOT_RC_REQUIRE_RESEARCHER_AUTH=true

# Render sets PORT automatically. This fallback is only for local checks.
PORT=10000
